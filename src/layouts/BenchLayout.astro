---
import Layout from '~/layouts/Layout.astro';

interface Props {
  title?: string;
  description?: string;
  slice?: string;
}

const {
  title = 'Skeg benchmarks',
  description = 'Benchmark reports and measurement data for Skeg.',
  slice,
} = Astro.props;
const archive = slice && slice !== 'release-08';
---
<Layout title={title} description={description} charts={Boolean(slice)}>
  <Fragment slot="navigation">
    <a href="/bench/" aria-current={!slice ? 'page' : undefined}>Benchmarks</a>
    <a href="/bench/release-0.8/" aria-current={slice === 'release-08' ? 'page' : undefined}>0.8 report</a>
    <a href="/bench/#archive" class:list={{ 'is-archive': archive }}>Archive</a>
  </Fragment>
  <slot />
</Layout>
