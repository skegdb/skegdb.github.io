---
import '~/styles/global.css';
import '~/styles/bench.css';

interface Props {
  title?: string;
  description?: string;
  charts?: boolean;
}

const {
  title = 'Skeg releases and Actions',
  description = 'Latest Skeg releases, downloads, and GitHub Actions results.',
  charts = false,
} = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="dark" class="benchmark-document">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0a0a0a" />
  <link rel="icon" type="image/svg+xml" href="/bench/brand/favicon.svg" />
  {charts && <script is:inline src="https://cdn.jsdelivr.net/npm/echarts@5.5.1/dist/echarts.min.js"></script>}
</head>
<body class="benchmark-body">
  <a href="#main-content" class="bench-skip">Skip to content</a>
  <header class="bench-masthead">
    <div class="bench-masthead-inner">
      <a href="https://skegdb.com/" aria-label="Skeg website" class="bench-brand">
        <img src="/bench/brand/skeg-logo.svg" width="132" height="44" alt="Skeg" />
      </a>
      <nav aria-label="Site navigation">
        <slot name="navigation">
          <a href="/#releases" aria-current="page">Releases</a>
          <a href="/#actions">Actions</a>
          <a href="/bench/">Benchmarks</a>
        </slot>
      </nav>
      <a class="bench-outbound" href="https://github.com/skegdb/skeg">GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </header>
  <main class="bench-main bench-width" id="main-content">
    <slot />
  </main>
  <footer class="bench-end bench-width">
    <a href="https://skegdb.com/">Skeg website <span aria-hidden="true">↗</span></a>
    <a href="/">Releases &amp; Actions</a>
    <a href="/bench/">Benchmarks</a>
    <a href="https://github.com/skegdb/skegdb.github.io">Site source <span aria-hidden="true">↗</span></a>
  </footer>
</body>
</html>
