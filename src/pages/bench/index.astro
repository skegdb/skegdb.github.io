---
import BenchLayout from '~/layouts/BenchLayout.astro';
import index from '~/data/bench/index.json';
import report from '~/data/bench/release-0.8.json';



const archive = [
  { id: 'release', href: 'release-0.5', title: 'Skeg 0.5', text: 'Quantization, tenant isolation, and cold starts.' },
  { id: 'a', href: 'slice-a', title: 'Engine comparison', text: 'Recall, memory, and build time across corpus sizes.' },
  { id: 'b', href: 'slice-b', title: 'Search efficiency', text: 'Recall versus latency as search effort increases.' },
  { id: 'c', href: 'slice-c', title: 'Concurrency', text: 'Throughput and latency across client counts.' },
  { id: 'd', href: 'slice-d', title: 'Shared machine', text: 'Vector retrieval alongside a local language model.' },
  { id: 'e', href: 'slice-e', title: 'Quantization and startup', text: 'Index configurations, memory use, and cold starts.' },
].filter(report => index.slices.some(slice => slice.id === report.id && slice.available));
---

<BenchLayout>
  <header>
    <h1 class="bench-title">Benchmarks</h1>
    <p class="bench-intro">Measure search quality, latency, throughput and resource use under documented workloads.</p>
  </header>

  <section class="featured" aria-labelledby="featured-title">
    <div>
      <p class="bench-kicker">November 2026</p>
      <h2 id="featured-title">Skeg 0.8</h2>
      <p>Compare embedding workloads on Linux and Skeg configurations on macOS. The Linux campaign includes datasets up to 5 million vectors.</p>
      <a class="bench-action" href="/bench/release-0.8/">Read the report <span aria-hidden="true">↗</span></a>
    </div>
    <dl>
      <div><dt>macOS</dt><dd>{report.local.configurations.length} profiles · {report.local.shards} shards</dd></div>
      {report.cloud.hosts.map(host => (
        <div><dt>Linux {host.arch === 'arm64' ? 'ARM64' : host.arch}</dt><dd>{host.runs.length} datasets · {host.shards} shards</dd></div>
      ))}
    </dl>
  </section>

  <section id="archive" aria-labelledby="archive-title">
    <h2 id="archive-title">Archive</h2>
    <ul class="archive">
      {archive.map(report => (
        <li><a href={`/bench/${report.href}/`}><strong>{report.title}</strong><span>{report.text}</span><span class="arrow" aria-hidden="true">↗</span></a></li>
      ))}
    </ul>
  </section>
</BenchLayout>

<style>
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr);
    gap: clamp(24px, 6vw, 88px);
    align-items: end;
    padding: clamp(20px, 4vw, 56px);
    margin-block: 44px 68px;
    background: var(--bg-emphasis);
    border: 1px solid var(--rule);
  }
  .featured h2 { margin: 14px 0 12px; font-size: clamp(36px, 5vw, 70px); line-height: 1; letter-spacing: -.055em; }
  .featured p:not(.bench-kicker) { margin: 0 0 22px; max-width: 50ch; color: var(--mute); }
  .featured dl { margin: 0; font: 12px/1.6 var(--mono); }
  .featured dl div { padding: 14px 0; border-top: 1px solid var(--rule); }
  .featured dt { color: var(--mute); }
  .featured dd { margin: 3px 0 0; }
  #archive-title { font-size: 34px; font-weight: 600; letter-spacing: -.035em; }
  .archive { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .archive a { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr) auto; gap: 12px 20px; padding: 21px 0; }
  .archive strong { font-weight: 600; font-size: 17px; }
  .archive span { color: var(--mute); }
  .archive .arrow { color: var(--accent); }
  @media (max-width: 680px) {
    .featured { grid-template-columns: 1fr; }
    .archive a { grid-template-columns: 1fr auto; }
    .archive a span:nth-child(2) { grid-row: 2; }
    .archive .arrow { grid-row: 1; grid-column: 2; }
  }
</style>
